rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function account(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function ownsActiveVault(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.keys().hasAll(['privatePro', 'privateProEpoch'])
        && request.auth.token.privatePro == true
        && request.auth.token.privateProEpoch is int
        && account(uid).active == true
        && account(uid).accessEpoch == request.auth.token.privateProEpoch;
    }

    match /users/{uid} {
      allow read: if ownsActiveVault(uid);
      allow write: if false;

      match /chats/{chatId} {
        allow read: if ownsActiveVault(uid);
        allow write: if false;

        match /revisions/{revisionId} {
          allow read: if ownsActiveVault(uid);
          allow write: if false;

          match /chunks/{chunkId} {
            allow read: if ownsActiveVault(uid);
            allow write: if false;
          }
        }
      }

      match /personas/{personaId} {
        allow read: if ownsActiveVault(uid);
        allow write: if false;
      }

      match /tombstones/{tombstoneId} {
        allow read: if ownsActiveVault(uid);
        allow write: if false;
      }

      match /assets/{assetId} {
        allow read: if ownsActiveVault(uid);
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read: if ownsActiveVault(uid);
        allow write: if false;
      }

      match /quotaReservations/{reservationId} {
        allow read, write: if false;
      }

      match /uploadRateWindows/{windowId} {
        allow read, write: if false;
      }

      match /chatUploads/{uploadId} {
        allow read, write: if false;

        match /chunks/{chunkId} {
          allow read, write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
